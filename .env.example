# Example environment configuration for Secondsight.
#
# Nothing in the Python code loads a .env file. The command-line tools and the
# Gradio demo read the REID_* variables from the process environment, so export
# them in your shell, for example:
#   bash:        export REID_DATA_ROOT=/path/to/Market-1501-v15.09.15
#   PowerShell:  $env:REID_DATA_ROOT = "C:\path\to\Market-1501-v15.09.15"
#
# docker compose is the one tool that reads a .env file in the repository root
# automatically. It uses only the SECONDSIGHT_* host paths below. Never commit
# your real .env file (it is git-ignored).

# --- Read by the CLIs and the Gradio demo (export in your shell) -----------

# Market-1501 dataset root, used when --data-root is not given. This is the
# directory that contains bounding_box_train/, query/, and bounding_box_test/
# (typically .../Market-1501-v15.09.15). `make download` prints it.
REID_DATA_ROOT=

# Trained checkpoint (.pth) loaded by the Gradio demo, the Docker image and the
# Hugging Face Space when --weights is not given. If it is missing, the demo
# falls back to a randomly initialized model so it still launches.
REID_WEIGHTS=outputs/best.pth

# --- Read by docker compose only (host paths, mounted read-only) -----------

# Host folder holding best.pth. Defaults to ./outputs.
SECONDSIGHT_OUTPUTS_DIR=./outputs

# Host folder that directly contains bounding_box_test/. Defaults to ./data.
SECONDSIGHT_DATA_DIR=./data
